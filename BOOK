<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SOFC工作台账</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Microsoft Yahei}
body{display:flex;height:100vh;background:#f4f6f8;overflow:hidden;}
/*侧边栏 移动端适配*/
.sidebar{width:240px;background:#2c3e50;color:#fff;padding:20px;transition:0.3s;}
.sidebar.close{width:0;padding:0;overflow:hidden}
.sidebar h3{margin-bottom:24px;font-size:18px}
.nav-item{padding:12px 14px;margin:6px 0;border-radius:6px;cursor:pointer}
.nav-item:hover{background:#34495e}
.nav-item.active{background:#3498db}
.toggle-bar{display:none;padding:10px;background:#2c3e50;color:#fff;text-align:center;cursor:pointer;font-size:20px}
/*主内容区*/
.main{flex:1;padding:16px;overflow:auto;height:100vh}
.top-bar{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;align-items:center}
.search-wrap{display:flex;gap:8px;flex:1;min-width:260px}
#searchInput{flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:5px}
button{padding:8px 10px;border:none;border-radius:5px;cursor:pointer;color:#fff;font-size:14px}
.btn-blue{background:#3498db}
.btn-green{background:#27ae60}
.btn-gray{background:#95a5a6}
.btn-red{background:#e74c3c}
.btn-orange{background:#e67e22}
.card{background:#fff;padding:14px;border-radius:8px;box-shadow:0 1px 4px #00000018;margin-bottom:12px}
textarea{width:100%;min-height:80px;padding:10px;margin:8px 0;border:1px solid #ddd;border-radius:6px;font-size:15px}
input{padding:8px;border:1px solid #ddd;border-radius:6px;margin:4px;font-size:15px}
.item-title{font-weight:bold;margin-bottom:6px;margin-top:10px}
.operate{margin-top:8px;display:flex;gap:8px;flex-wrap:wrap}
.highlight{background:#fffd88}
.tip{color:#666;margin:8px 0;}
.modal{background:#fff;padding:16px;border-radius:8px;margin:16px 0;border:1px solid #ddd}
.report-area{white-space:pre-wrap;background:#f8f8f8;padding:12px;border-radius:6px;max-height:320px;overflow:auto;margin:10px 0;font-size:14px}

/*手机屏幕适配*/
@media (max-width:768px){
    .toggle-bar{display:block}
    .sidebar{position:absolute;height:100vh;z-index:99}
    .main{padding:12px}
    h2{font-size:18px}
}
</style>
</head>
<body>
<div class="toggle-bar" id="toggleBtn">☰ 展开分类菜单</div>
<div class="sidebar" id="sideBar">
<h3>台账分类</h3>
<div class="nav-item" data-type="电池生产">电池生产</div>
<div class="nav-item" data-type="密封生产">密封生产</div>
<div class="nav-item" data-type="电堆生产">电堆生产</div>
<div class="nav-item" data-type="电池研发">电池研发</div>
<div class="nav-item" data-type="密封研发">密封研发</div>
<div class="nav-item" data-type="电堆研发">电堆研发</div>
</div>
<div class="main">
<div class="top-bar">
    <div class="search-wrap">
        <input id="searchInput" placeholder="关键词全局搜索">
        <button class="btn-blue" id="searchBtn">搜索</button>
        <button class="btn-gray" id="resetBtn">清除搜索</button>
    </div>
    <button class="btn-blue" id="addBtn">新增记录</button>
    <button class="btn-green" id="exportBtn">导出全部台账</button>
    <button class="btn-orange" id="weekReportBtn">生成周报</button>
    <button class="btn-orange" id="monthReportBtn">生成月报</button>
</div>
<h2 id="curTypeName">请选择左侧分类</h2>
<div class="tip" id="searchTip"></div>
<div id="listWrap"></div>

<!--新增记录弹窗-->
<div id="editBox" class="modal" style="display:none;">
<div class="item-title">当日进度</div>
<textarea id="progress"></textarea>
<div class="item-title">现存问题</div>
<textarea id="problem"></textarea>
<div class="item-title">思路与改善想法</div>
<textarea id="idea"></textarea>
<div class="operate">
<button class="btn-blue" id="save">保存</button>
<button class="btn-gray" id="cancel">取消</button>
</div>
</div>

<!--周报弹窗-->
<div id="weekModal" class="modal" style="display:none;">
<h3>自动生成周报</h3>
<div style="margin:10px 0;display:flex;flex-wrap:wrap;gap:6px;align-items:center;">
起止日期：
<input type="date" id="weekStart"> ~
<input type="date" id="weekEnd">
<button class="btn-blue" id="buildWeek">生成周报</button>
</div>
<div class="report-area" id="weekResult"></div>
<div class="operate">
<button class="btn-green" id="copyWeek">复制周报文本</button>
<button class="btn-gray" id="closeWeek">关闭</button>
</div>
</div>

<!--月报弹窗-->
<div id="monthModal" class="modal" style="display:none;">
<h3>自动生成月报</h3>
<div style="margin:10px 0;">
选择月份：<input type="month" id="selectMonth">
<button class="btn-blue" id="buildMonth">生成月报</button>
</div>
<div class="report-area" id="monthResult"></div>
<div class="operate">
<button class="btn-green" id="copyMonth">复制月报文本</button>
<button class="btn-gray" id="closeMonth">关闭</button>
</div>
</div>

</div>

<script>
//分类
const types = ["电池生产","密封生产","电堆生产","电池研发","密封研发","电堆研发"];
let currentType = "";
let searchText = "";

//移动端侧边栏折叠
const sideBar = document.getElementById("sideBar");
const toggleBtn = document.getElementById("toggleBtn");
toggleBtn.onclick = ()=>{
    sideBar.classList.toggle("close");
}

//本地存储读取
let data = JSON.parse(localStorage.getItem("workLogData")) || {};
types.forEach(t=>{if(!data[t]) data[t]=[]})

const navItems = document.querySelectorAll(".nav-item");
const curTitle = document.getElementById("curTypeName");
const listWrap = document.getElementById("listWrap");
const addBtn = document.getElementById("addBtn");
const editBox = document.getElementById("editBox");
const saveBtn = document.getElementById("save");
const cancelBtn = document.getElementById("cancel");
const exportBtn = document.getElementById("exportBtn");
const searchInput = document.getElementById("searchInput");
const searchBtn = document.getElementById("searchBtn");
const resetBtn = document.getElementById("resetBtn");
const searchTip = document.getElementById("searchTip");

//周报控件
const weekReportBtn = document.getElementById("weekReportBtn");
const weekModal = document.getElementById("weekModal");
const weekStart = document.getElementById("weekStart");
const weekEnd = document.getElementById("weekEnd");
const buildWeek = document.getElementById("buildWeek");
const weekResult = document.getElementById("weekResult");
const copyWeek = document.getElementById("copyWeek");
const closeWeek = document.getElementById("closeWeek");

//月报控件
const monthReportBtn = document.getElementById("monthReportBtn");
const monthModal = document.getElementById("monthModal");
const selectMonth = document.getElementById("selectMonth");
const buildMonth = document.getElementById("buildMonth");
const monthResult = document.getElementById("monthResult");
const copyMonth = document.getElementById("copyMonth");
const closeMonth = document.getElementById("closeMonth");

//切换分类
navItems.forEach(item=>{
item.onclick=()=>{
navItems.forEach(i=>i.classList.remove("active"));
item.classList.add("active");
currentType = item.dataset.type;
curTitle.innerText = currentType;
renderList();
editBox.style.display="none";
//手机点击分类后自动收起侧边栏
if(window.innerWidth <=768){
    sideBar.classList.add("close");
}
}
})

//关键词高亮
function highlightText(text, keyword){
    if(!keyword) return text;
    const reg = new RegExp(`(${keyword})`,"gi");
    return text.replace(reg,`<span class="highlight">$1</span>`);
}

//渲染列表
function renderList(){
listWrap.innerHTML = "";
searchTip.innerText = "";

if(searchText.trim() !== ""){
    let resultList = [];
    for(let cat of types){
        data[cat].forEach((item,idx)=>{
            const allText = (item.progress + item.problem + item.idea).toLowerCase();
            if(allText.includes(searchText.toLowerCase())){
                resultList.push({cat,idx,item});
            }
        })
    }
    if(resultList.length === 0){
        listWrap.innerHTML="<div class='card'>未找到匹配记录</div>";
        searchTip.innerText=`搜索关键词：${searchText}，无结果`;
        return;
    }
    searchTip.innerText=`搜索关键词【${searchText}】，共找到 ${resultList.length} 条记录`;
    resultList.forEach(row=>{
        const div = document.createElement("div");
        div.className="card";
        div.innerHTML=`
        <div><b>分类：${row.cat} | 日期：${row.item.date}</b></div>
        <div class="item-title">进度</div>
        <div>${highlightText(row.item.progress||"-",searchText)}</div>
        <div class="item-title">问题</div>
        <div>${highlightText(row.item.problem||"-",searchText)}</div>
        <div class="item-title">想法/方案</div>
        <div>${highlightText(row.item.idea||"-",searchText)}</div>
        `;
        listWrap.appendChild(div);
    })
    return;
}

const arr = data[currentType] || [];
if(arr.length===0){
listWrap.innerHTML="<div class='card'>暂无记录，点击新增记录填写工作信息</div>";
return;
}
arr.forEach((item,idx)=>{
const div = document.createElement("div");
div.className="card";
div.innerHTML=`
<div><b>记录日期：${item.date}</b></div>
<div class="item-title">进度</div>
<div>${item.progress||"-"}</div>
<div class="item-title">问题</div>
<div>${item.problem||"-"}</div>
<div class="item-title">想法/方案</div>
<div>${item.idea||"-"}</div>
<div class="operate">
<button class="btn-red del" data-idx="${idx}">删除本条</button>
</div>
`;
listWrap.appendChild(div);
})
document.querySelectorAll(".del").forEach(btn=>{
btn.onclick=()=>{
const i = Number(btn.dataset.idx);
if(confirm("确定删除这条记录？")){
data[currentType].splice(i,1);
saveData();renderList();
}
}
})
}

//搜索
searchBtn.onclick = ()=>{
    searchText = searchInput.value.trim();
    renderList();
}
searchInput.onkeydown = (e)=>{
    if(e.key === "Enter"){
        searchText = searchInput.value.trim();
        renderList();
    }
}
resetBtn.onclick = ()=>{
    searchText = "";
    searchInput.value = "";
    renderList();
}

//新增记录
addBtn.onclick=()=>{
if(!currentType){alert("请先在左侧选择分类！");return}
document.getElementById("progress").value="";
document.getElementById("problem").value="";
document.getElementById("idea").value="";
editBox.style.display="block";
weekModal.style.display="none";
monthModal.style.display="none";
}
cancelBtn.onclick=()=>editBox.style.display="none";

saveBtn.onclick=()=>{
const progress = document.getElementById("progress").value.trim();
const problem = document.getElementById("problem").value.trim();
const idea = document.getElementById("idea").value.trim();
data[currentType].push({
date:new Date().toLocaleDateString(),
progress,problem,idea
})
saveData();
editBox.style.display="none";
renderList();
alert("保存成功！");
}

function saveData(){
localStorage.setItem("workLogData",JSON.stringify(data));
}

//导出台账
exportBtn.onclick=()=>{
let text="分类\t日期\t进度\t问题\t想法\n";
for(let t of types){
for(let item of data[t]){
text += `${t}\t${item.date}\t${item.progress}\t${item.problem}\t${item.idea}\n`
}
}
navigator.clipboard.writeText(text);
alert("已复制全部台账！粘贴到Excel/记事本保存");
}

// ========== 周报逻辑 ==========
weekReportBtn.onclick = ()=>{
    weekModal.style.display="block";
    monthModal.style.display="none";
    editBox.style.display="none";
    const now=new Date();
    weekEnd.valueAsDate = now;
    let s = new Date();
    s.setDate(now.getDate()-6);
    weekStart.valueAsDate = s;
}
closeWeek.onclick = ()=> weekModal.style.display="none";

buildWeek.onclick = ()=>{
    const sDate = weekStart.value;
    const eDate = weekEnd.value;
    if(!sDate||!eDate){alert("请选择起止日期");return;}
    let reportText = `====== 工作周报【${sDate} ~ ${eDate}】======\n`;
    for(let cat of types){
        const list = data[cat].filter(row=>{
            const dStr = row.date.replace(/\//g,"-");
            return dStr >= sDate && dStr <= eDate;
        })
        if(list.length===0) continue;
        reportText += `\n【${cat}】\n`;
        list.forEach(r=>{
            reportText += `日期：${r.date}\n`;
            reportText += `●进度：${r.progress}\n`;
            reportText += `●现存问题：${r.problem}\n`;
            reportText += `●思路方案：${r.idea}\n\n`;
        })
    }
    weekResult.innerText = reportText || "该时间段暂无记录";
}
copyWeek.onclick=()=>{
    navigator.clipboard.writeText(weekResult.innerText);
    alert("周报已复制剪贴板！");
}

// ========== 月报逻辑 ==========
monthReportBtn.onclick = ()=>{
    monthModal.style.display="block";
    weekModal.style.display="none";
    editBox.style.display="none";
    const now=new Date();
    selectMonth.value = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;
}
closeMonth.onclick = ()=> monthModal.style.display="none";

buildMonth.onclick = ()=>{
    const mVal = selectMonth.value;
    if(!mVal){alert("选择月份");return;}
    const year = mVal.split("-")[0];
    const month = mVal.split("-")[1];
    let reportText = `====== 工作月报【${year}年${month}月】======\n`;
    for(let cat of types){
        const list = data[cat].filter(row=>{
            const dArr = row.date.split("/");
            const dYear = dArr[0];
            const dMonth = String(Number(dArr[1])).padStart(2,"0");
            return dYear === year && dMonth === month;
        })
        if(list.length===0) continue;
        reportText += `\n【${cat}】\n`;
        list.forEach(r=>{
            reportText += `日期：${r.date}\n`;
            reportText += `●进度：${r.progress}\n`;
            reportText += `●现存问题：${r.problem}\n`;
            reportText += `●思路方案：${r.idea}\n\n`;
        })
    }
    monthResult.innerText = reportText || "该月份暂无记录";
}
copyMonth.onclick=()=>{
    navigator.clipboard.writeText(monthResult.innerText);
    alert("月报已复制剪贴板！");
}
</script>
</body>
</html>
